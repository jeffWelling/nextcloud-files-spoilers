{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": false,
		"noEmit": true,
		"types": ["node"],
		"typeRoots": ["./", "../../node_modules/@types"]
	},
	"include": [
		"**/*.ts",
		"types.d.ts"
	]
}
